# Instagram
IG_SESSIONID=
TRIGGER=.eww
POLL_INTERVAL=3
REALTIME=1
PROCESS_BACKLOG=0
DRY_RUN=0
MAX_MB=60
DATA_DIR=./data

# Telegram control bot (also used for storage)
TG_TOKEN=
TG_ADMIN_IDS=123456789
TG_CONTROL_CHAT=

# Telegram private channel for media
TG_STORAGE_CHANNEL=-1001234567890
# Optional: separate channel for DB backups
TG_DB_CHANNEL=-1001234567890

# Limits
FREE_DAILY=10

# Extra IG admins (usernames, comma separated)
EXTRA_ADMINS=ammar._.azam,noxmirage_
